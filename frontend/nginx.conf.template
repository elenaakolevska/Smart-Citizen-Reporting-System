server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # No URI on proxy_pass = forward the request URI unchanged. The frontend
    # already sends /api/v1/... (see frontend/src/services/api.ts), so we keep
    # one canonical path end-to-end and avoid path rewrites.
    # ${BACKEND_FQDN} is resolved by envsubst at container startup using
    # /etc/resolv.conf (the env's internal DNS, which is the only one that
    # knows *.internal.<env> FQDNs). nginx caches the IP for the container's
    # lifetime; the deploy workflow always redeploys the frontend after the
    # backend, which gives us a fresh resolution on every release.
    location /api/ {
        proxy_pass         https://${BACKEND_FQDN};
        proxy_http_version 1.1;
        proxy_set_header   Host                ${BACKEND_FQDN};
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        client_max_body_size 6m;
    }

    location /static/ {
        proxy_pass         https://${BACKEND_FQDN};
        proxy_http_version 1.1;
        proxy_set_header   Host                ${BACKEND_FQDN};
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
