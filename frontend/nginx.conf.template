# Azure-internal DNS. Re-resolves the backend FQDN at request time so a backend
# revision rollover (new pod IP) doesn't strand nginx with a stale cache.
resolver 168.63.129.16 valid=30s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Trailing slash on proxy_pass strips /api/ and substitutes /api/v1/,
    # matching FastAPI's settings.api_v1_str mount point. The variable forces
    # nginx to honour the resolver above instead of caching at startup.
    location /api/ {
        set $backend_fqdn ${BACKEND_FQDN};
        proxy_pass         https://$backend_fqdn/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $backend_fqdn;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        client_max_body_size 6m;
    }

    location /static/ {
        set $backend_fqdn ${BACKEND_FQDN};
        proxy_pass         https://$backend_fqdn/static/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $backend_fqdn;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
